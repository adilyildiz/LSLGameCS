<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
    <PackageReference Include="SharpLSL" Version="1.17.6" />
    <PackageReference Include="SharpLSL.Native.win-x64" Version="1.17.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LslGame.Core\LslGame.Core.csproj" />
    <ProjectReference Include="..\LslGame.Control\LslGame.Control.csproj" />
    <ProjectReference Include="..\LslGame.Online\LslGame.Online.csproj" />
    <ProjectReference Include="..\LslGame.Simulation\LslGame.Simulation.csproj" />
    <ProjectReference Include="..\LslGame.Calibration\LslGame.Calibration.csproj" />
    <ProjectReference Include="..\LslGame.Models\LslGame.Models.csproj" />
  </ItemGroup>

</Project>
